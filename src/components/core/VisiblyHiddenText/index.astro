---
import type { HTMLTag } from "astro/types";

type Props = {
  id?: string;
  as?: HTMLTag;
};

const { id, as: Tag = "span" } = Astro.props;
---

<Tag class="srOnly" id={id}><slot /></Tag>

<style>
  .srOnly {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip-path: inset(50%);
    overflow: hidden;
    white-space: nowrap;
  }
</style>
