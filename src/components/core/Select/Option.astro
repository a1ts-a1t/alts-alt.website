---
import checkmarkIcon from "~/assets/icons/checkmark.svg";
import Icon from "~/components/core/Icon";
import type { OptionProps } from "./utils";

type Props = OptionProps;

const { label, value, id } = Astro.props;
---

<div
  role="option"
  id={id}
  class="option"
  data-label={label}
  data-value={value}
  aria-selected="false"
>
  <span class="label"> {label} </span>
  <Icon class="check" src={checkmarkIcon} size="md" color="text" />
</div>

<style>
  .option {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    column-gap: 16px;
    min-width: max-content;
    padding: 8px;
    border-bottom: 1px dotted var(--color-text);
    cursor: pointer;
  }

  .option:last-child {
    border-bottom: none;
  }

  .option :global(.check) {
    visibility: hidden;
  }

  .option[aria-selected="true"] :global(.check) {
    visibility: visible;
  }

  .focus .label {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
