---
import { type IconProps, toSrcUrl } from "./utils";

type Props = IconProps;

const { color, id, class: className, style = {}, size, src } = Astro.props;
---

<span
  id={id}
  class:list={[
    "icon",
    color === undefined ? undefined : `color-${color}`,
    size === undefined ? undefined : `size-${size}`,
    className,
  ]}
  aria-hidden="true"
  style={{
    "--Icon-src": `url(${toSrcUrl(src)})`,
    ...style,
  }}
> </span>

<style>
  .icon {
    display: block;
    height: var(--Icon-size, 16px);
    width: var(--Icon-size, 16px);
    background-color: var(--Icon-color, var(--color-text));
    mask-image: var(--Icon-src);
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: contain;
  }

  .color-bg {
    --Icon-color: var(--color-bg);
  }

  .color-text {
    --Icon-color: var(--color-text);
  }

  .color-primary {
    --Icon-color: var(--color-primary);
  }

  .color-secondary {
    --Icon-color: var(--color-secondary);
  }

  .color-enabled {
    --Icon-color: var(--color-enabled);
  }

  .color-muted {
    --Icon-color: var(--color-muted);
  }

  .size-xs {
    --Icon-size: 12px;
  }

  .size-sm {
    --Icon-size: 16px;
  }

  .size-md {
    --Icon-size: 20px;
  }

  .size-lg {
    --Icon-size: 24px;
  }

  .size-xl {
    --Icon-size: 28px;
  }
</style>
