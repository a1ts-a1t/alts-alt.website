---
type Props = { id: string; fallback: string };
const { id, fallback } = Astro.props;
---

<project-preview class="image" data-image-state="pending" id={id}>
  <slot />
  <span class="fallback">{fallback}</span>
</project-preview>

<script>
  import { getBySelector } from "~/lib/dom";

  class ProjectPreview extends HTMLElement {
    #wired = false;

    connectedCallback(): void {
      if (this.#wired) {
        return;
      }

      this.#wired = true;

      const image = getBySelector<HTMLImageElement>(this, "img");

      // cached images can finish loading before this script runs
      if (image.complete) {
        this.dataset.imageState = image.naturalWidth > 0 ? "loaded" : "error";
      }

      image.addEventListener("load", () => {
        this.dataset.imageState = "loaded";
      });

      image.addEventListener("error", () => {
        this.dataset.imageState = "error";
      });
    }
  }

  customElements.define("project-preview", ProjectPreview);
</script>

<style>
  .image {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .image > :global(*) {
    max-height: 100%;
    max-width: 100%;
  }

  .image:not([data-image-state="loaded"]) .source {
    visibility: hidden;
  }

  .fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-muted);
    color: var(--color-text);
    text-align: center;
    padding: 16px;
  }

  .image[data-image-state="loaded"] .fallback {
    display: none;
  }
</style>
