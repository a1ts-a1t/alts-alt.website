---
import ColorOptions from "./ColorOptions.astro";
import ImageUploader from "./ImageUploader.astro";
import PalettePicker from "./PalettePicker.astro";
import WebGlCanvas from "./WebGlCanvas.astro";
---

<div class="palette-posterizer">
  <ColorOptions />
  <ImageUploader />
  <WebGlCanvas />
  <PalettePicker />
</div>

<style>
  .palette-posterizer {
    display: flex;
    flex-direction: column;
    row-gap: 8px;
  }
</style>

<script>
  import { listenKeys } from "nanostores";
  import { getById } from "~/lib/dom";
  import { stateStore } from "./state";

  listenKeys(stateStore, ["image"], ({ image }) => {
    getById("palette-posterizer-image-uploader").hidden = image !== undefined;
  });
</script>
