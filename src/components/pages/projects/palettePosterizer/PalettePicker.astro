---
import addIcon from "~/assets/icons/add.svg";
import chevronDownIcon from "~/assets/icons/chevron-down.svg";
import IconButton from "~/components/core/IconButton";
import Menu from "~/components/core/Menu";
import MenuItem from "~/components/core/Menu/MenuItem.astro";
import { PALETTE_OPTIONS } from "./palettes";

type Props = Record<string, never>;

const menuItems = PALETTE_OPTIONS.map(({ name, palette }, index) => ({
  id: `default-palette-option-${index}`,
  name,
  palette,
}));
---

<div id="palette-picker" class="palette-picker" hidden>
  <div class="menu-cell">
    <IconButton
      id="default-palettes-trigger"
      src={chevronDownIcon}
      aria-label="Choose from default palettes"
      size="lg"
      appearance="bordered"
    />
    <Menu id="default-palettes-menu">
      {menuItems.map(({ id, name, palette }) => (
          <MenuItem id={id} label={name}>
            <div slot="trailing" class="palette-strip">
              {palette.map((color) => (
                <div
                  class="strip-swatch"
                  style={`background-color: ${color.asRgbString()};`}
                  aria-hidden="true"
                />
              ))}
            </div>
          </MenuItem>
        ))}
    </Menu>
  </div>

  <div class="new-color-cell">
    <div class="tile add-tile">
      <span
        class:list={["bg-clip", "add-icon"]}
        style={{ "--bg-image": `url(${addIcon.src})` }}
        aria-hidden="true"
      ></span>
      <input
        class="add-input"
        id="palette-picker-add-input"
        type="color"
        value="#000000"
        aria-label="Add a new color"
      >
    </div>
  </div>

  <div class="swatch-row" id="palette-picker-swatch-row"></div>
</div>

<style>
  .palette-picker {
    position: relative;
    display: flex;
    flex-direction: row;
    column-gap: 8px;
    padding: 4px 0;
  }

  .palette-picker[hidden] {
    display: none;
  }

  .menu-cell {
    position: relative;
    padding-top: 4px;
  }

  .new-color-cell {
    padding-top: 4px;
  }

  .palette-strip {
    display: flex;
    flex-direction: row;
    max-width: calc(100vw / 3);
    overflow-x: auto;
    border: 1px solid var(--color-text);
  }

  .strip-swatch {
    height: 20px;
    min-width: 20px;
    width: 20px;
    margin-block: auto;
  }

  .tile {
    height: 40px;
    width: 40px;
    border: 1px solid var(--color-text);
    background-color: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .add-icon {
    height: 100%;
    width: 16px;
    background-color: var(--color-text);
  }

  .add-tile {
    position: relative;
  }

  .add-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .swatch-row {
    display: flex;
    flex-direction: row;
    column-gap: 8px;
    width: 100%;
    overflow-x: auto;
    padding-top: 4px;
  }
</style>

<style is:global>
  #palette-picker .swatch-cell {
    position: relative;
    width: fit-content;
    flex-shrink: 0;
  }

  #palette-picker .swatch {
    display: block;
    height: 40px;
    width: 40px;
    padding: 0;
    border: 1px solid var(--color-text);
    background-color: transparent;
    cursor: pointer;
  }

  #palette-picker .swatch::-webkit-color-swatch-wrapper {
    padding: 0;
  }

  #palette-picker .swatch::-webkit-color-swatch {
    border: none;
  }

  #palette-picker .swatch::-moz-color-swatch {
    border: none;
  }

  #palette-picker .remove-swatch {
    position: absolute;
    top: -4px;
    right: -4px;
    display: flex;
    height: 24px;
    width: 24px;
    border: 1px solid var(--color-text);
    background-color: var(--color-bg);
    cursor: pointer;
    z-index: 1;
  }

  #palette-picker .remove-swatch-icon {
    margin: auto;
    height: 12px;
    width: 12px;
    background-color: var(--color-text);
  }
</style>

<script>
  import { listenKeys } from "nanostores";
  import chevronDownIcon from "~/assets/icons/chevron-down.svg";
  import chevronUpIcon from "~/assets/icons/chevron-up.svg";
  import crosshairIcon from "~/assets/icons/crosshair.svg";
  import { updateIconButton } from "~/components/core/IconButton/utils";
  import { createMenu } from "~/components/core/Menu/utils";
  import { Color } from "~/lib/color";
  import { getById, HTMLStringBuilder } from "~/lib/dom";
  import { PALETTE_OPTIONS } from "./palettes";
  import { stateStore } from "./state";

  const root = getById("palette-picker");
  const swatchRow = getById("palette-picker-swatch-row");

  // render palette picker only when an image is loaded in
  listenKeys(stateStore, ["image"], ({ image }) => {
    root.hidden = image === undefined;
  });

  createMenu({
    triggerId: "default-palettes-trigger",
    menuId: "default-palettes-menu",
    onOpenChange: (state) => {
      updateIconButton("default-palettes-trigger", {
        src: state === "open" ? chevronUpIcon : chevronDownIcon,
        "aria-label":
          state === "open"
            ? "Close palettes menu"
            : "Choose from default palettes",
      });
    },
  });

  for (const [index, { palette }] of PALETTE_OPTIONS.entries()) {
    getById(`default-palette-option-${index}`).addEventListener("click", () => {
      stateStore.setKey("palette", [...palette]);
    });
  }

  const renderSwatches = (palette: Color[]) => {
    swatchRow.innerHTML = palette
      .map((color, paletteIndex) => {
        const colorInputHtml = HTMLStringBuilder.fromTag("input")
          .withAttribute("class", "swatch")
          .withAttribute("type", "color")
          .withAttribute("aria-label", "Change color")
          .withAttribute("title", "Change color")
          .withAttribute("value", color.asHexString())
          .withAttribute("data-palette-index", String(paletteIndex))
          .asString();
        const removeIconHtml = HTMLStringBuilder.fromTag("span")
          .withAttribute("class", "bg-clip remove-swatch-icon")
          .withAttribute("aria-hidden", "true")
          .withAttribute("style", `--bg-image: url(${crosshairIcon.src})`)
          .asString();
        const swatchRemoverHtml = HTMLStringBuilder.fromTag("button")
          .withAttribute("class", "remove-swatch")
          .withAttribute("type", "button")
          .withAttribute("aria-label", "Remove color")
          .withAttribute("title", "Remove color")
          .withAttribute("data-palette-index", String(paletteIndex))
          .withInnerHtml(removeIconHtml)
          .asString();
        return HTMLStringBuilder.fromTag("div")
          .withAttribute("class", "swatch-cell")
          .withInnerHtml(`${colorInputHtml}${swatchRemoverHtml}`)
          .asString();
      })
      .join("");
  };

  swatchRow.addEventListener("change", (event) => {
    const target = event.target as HTMLInputElement;
    if (!target.matches("input.swatch")) {
      return;
    }

    const { palette } = stateStore.get();
    stateStore.setKey(
      "palette",
      palette.with(
        Number(target.dataset.paletteIndex),
        Color.fromHexString(target.value),
      ),
    );
  });

  swatchRow.addEventListener("click", (event) => {
    const remove = (event.target as HTMLElement).closest<HTMLElement>(
      ".remove-swatch",
    );
    if (remove === null) {
      return;
    }
    const { palette } = stateStore.get();
    stateStore.setKey(
      "palette",
      palette.toSpliced(Number(remove.dataset.paletteIndex), 1),
    );
  });

  getById<HTMLInputElement>("palette-picker-add-input").addEventListener(
    "change",
    (event) => {
      const value = (event.currentTarget as HTMLInputElement).value;
      const { palette } = stateStore.get();
      stateStore.setKey("palette", [...palette, Color.fromHexString(value)]);
    },
  );

  listenKeys(stateStore, ["palette"], ({ palette }) => {
    renderSwatches(palette);
  });

  renderSwatches(stateStore.get().palette);
</script>
