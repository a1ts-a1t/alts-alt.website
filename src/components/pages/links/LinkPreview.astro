---
import Icon from "~/components/core/Icon";
import type { IconSrc } from "~/components/core/Icon/utils";

interface Props {
  name: string;
  href: string;
  "aria-label"?: string;
  src?: IconSrc;
  color?: string;
}

const { name, href, src, color, "aria-label": ariaLabel } = Astro.props;

const cardStyle: Record<string, string> =
  color !== undefined ? { "--brand-color": color } : {};
---

<a
  class="card"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ariaLabel ?? `Link to ${name}`}
  style={cardStyle}
>
  <div class="content">
    <span class="iconFrame">
      <slot name="icon">
        {src !== undefined && (
          <Icon src={src} />
        )}
      </slot>
    </span>
    <div class="label">{name.toLowerCase()}</div>
  </div>
</a>

<style>
  .card {
    --Icon-color: var(--brand-color, var(--color-text));
    --Icon-size: 32px;
    color: var(--color-text);
    display: flex;
    align-items: center;
    height: 96px;
    border: 1px solid var(--color-text);
    cursor: pointer;
  }
  .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    row-gap: 8px;
    margin-inline: auto;
  }

  /* pixel-art icons keep their intrinsic aspect ratio */
  .iconFrame > :global(img) {
    height: var(--Icon-size);
    width: auto;
  }

  .label {
    font-size: var(--font-sm);
  }

  @media (--sm) {
    .card {
      --Icon-size: 40px;
      height: 144px;
    }

    .label {
      font-size: 20px;
    }
  }
</style>
