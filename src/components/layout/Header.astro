---
import closedFolderIcon from "~/assets/icons/closed-folder.svg";
import configMenuClosedIcon from "~/assets/icons/config-menu-closed.svg";
import lightModeIcon from "~/assets/icons/light-mode.svg";
import reducedMotionIcon from "~/assets/icons/reduced-motion.svg";
import IconButton from "~/components/core/IconButton";
import Menu from "~/components/core/Menu";
import MenuItem from "~/components/core/Menu/MenuItem.astro";
import MenuItemLink from "~/components/core/Menu/MenuItemLink.astro";

type Props = Record<string, never>;
---

<header>
  <nav>
    <a class="homeLink" href="/" aria-label="Home">alts-alt!</a>
    <a href="/links" aria-label="Links">/links</a>
    <a href="/projects" aria-label="Projects">/projects</a>
  </nav>
  <div class="toolbar">
    <IconButton
      aria-label="Enable light mode"
      src={lightModeIcon}
      id="theme-button"
    />
    <IconButton
      aria-label="Enable reduced motion mode"
      src={reducedMotionIcon}
      id="motion-button"
    />
  </div>
  <div class="mobileBar">
    <IconButton
      id="navbar-menu-trigger"
      src={closedFolderIcon}
      aria-label="Open navigation menu"
    />
    <a class="homeLink" href="/" aria-label="Home">alts-alt!</a>
    <IconButton
      id="config-menu-trigger"
      src={configMenuClosedIcon}
      aria-label="Open config menu"
    />
  </div>
  <Menu id="navbar-menu" placement="left">
    <MenuItemLink id="navbar-home-menuitem" label="$HOME" href="/" />
    <MenuItemLink id="navbar-links-menuitem" label="/links" href="/links" />
    <MenuItemLink
      id="navbar-projects-menuitem"
      label="/projects"
      href="/projects"
    />
  </Menu>
  <Menu id="config-menu" placement="right">
    <MenuItem
      id="theme-menuitem"
      icon={lightModeIcon}
      label="Enable light mode"
    />
    <MenuItem
      id="motion-menuitem"
      icon={reducedMotionIcon}
      label="Enable reduced motion mode"
    />
  </Menu>
</header>

<style>
  header {
    flex: none;
    padding: 36px 0;
    flex-shrink: 1;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }

  nav {
    display: none;
    flex-direction: row;
    column-gap: 48px;
  }

  nav a {
    height: fit-content;
    color: var(--color-text);
  }

  nav a.homeLink {
    color: var(--color-primary);
    font-weight: bold;
  }

  .toolbar {
    display: none;
    flex-direction: row;
    column-gap: 4px;
  }

  .mobileBar {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .mobileBar a.homeLink {
    flex: 0 0 50%;
    text-align: center;
    color: var(--color-primary);
    font-weight: bold;
  }

  @media (--sm) {
    nav,
    .toolbar {
      display: flex;
    }

    .mobileBar {
      display: none;
    }
  }
</style>

<script>
  import closedFolderIcon from "~/assets/icons/closed-folder.svg";
  import configMenuClosedIcon from "~/assets/icons/config-menu-closed.svg";
  import configMenuOpenIcon from "~/assets/icons/config-menu-open.svg";
  import darkModeIcon from "~/assets/icons/dark-mode.svg";
  import lightModeIcon from "~/assets/icons/light-mode.svg";
  import noReducedMotionIcon from "~/assets/icons/no-reduced-motion.svg";
  import openFolderIcon from "~/assets/icons/open-folder.svg";
  import reducedMotionIcon from "~/assets/icons/reduced-motion.svg";
  import { updateIconButton } from "~/components/core/IconButton/utils";
  import { createMenu, updateMenuItem } from "~/components/core/Menu/utils";
  import { getById } from "~/lib/dom";
  import {
    getMotionMode,
    getThemeMode,
    motionStore,
    normalizeLocalStoreMotionMode,
    normalizeLocalStoreThemeMode,
    themeStore,
  } from "~/lib/settings";

  themeStore.subscribe((value) => {
    const theme = normalizeLocalStoreThemeMode(value);
    if (theme === "dark") {
      updateIconButton("theme-button", {
        "aria-label": "Enable light mode",
        src: lightModeIcon,
      });
      updateMenuItem("theme-menuitem", {
        label: "Enable light mode",
        icon: lightModeIcon,
      });
    } else {
      // light mode
      updateIconButton("theme-button", {
        "aria-label": "Enable dark mode",
        src: darkModeIcon,
      });
      updateMenuItem("theme-menuitem", {
        label: "Enable dark mode",
        icon: darkModeIcon,
      });
    }
  });

  const toggleTheme = () => {
    const theme = getThemeMode();
    if (theme === "dark") {
      themeStore.set("light");
    } else {
      // light mode
      themeStore.set("dark");
    }
  };

  getById("theme-button").addEventListener("click", toggleTheme);
  getById("theme-menuitem").addEventListener("click", toggleTheme);

  motionStore.subscribe((value) => {
    const motionMode = normalizeLocalStoreMotionMode(value);
    if (motionMode === "default") {
      updateIconButton("motion-button", {
        "aria-label": "Enable reduced motion mode",
        src: reducedMotionIcon,
      });
      updateMenuItem("motion-menuitem", {
        label: "Enabled reduced motion mode",
        icon: reducedMotionIcon,
      });
    } else {
      // reduced motion mode
      updateIconButton("motion-button", {
        "aria-label": "Disable reduced motion mode",
        src: noReducedMotionIcon,
      });
      updateMenuItem("motion-menuitem", {
        label: "Disable reduced motion mode",
        icon: noReducedMotionIcon,
      });
    }
  });

  const toggleMotionMode = () => {
    const motionMode = getMotionMode();
    if (motionMode === "default") {
      motionStore.set("reduced");
    } else {
      // reduced motion
      motionStore.set("default");
    }
  };

  getById("motion-button").addEventListener("click", toggleMotionMode);
  getById("motion-menuitem").addEventListener("click", toggleMotionMode);

  // wire up config menu
  createMenu({
    triggerId: "config-menu-trigger",
    menuId: "config-menu",
    onOpenChange: (state) => {
      if (state === "open") {
        updateIconButton("config-menu-trigger", {
          src: configMenuOpenIcon,
          "aria-label": "Close config menu",
        });
      } else {
        updateIconButton("config-menu-trigger", {
          src: configMenuClosedIcon,
          "aria-label": "Open config menu",
        });
      }
    },
  });

  // wire up navbar menu
  createMenu({
    triggerId: "navbar-menu-trigger",
    menuId: "navbar-menu",
    onOpenChange: (state) => {
      if (state === "open") {
        updateIconButton("navbar-menu-trigger", {
          src: openFolderIcon,
          "aria-label": "Close navigation menu",
        });
      } else {
        updateIconButton("navbar-menu-trigger", {
          src: closedFolderIcon,
          "aria-label": "Open navigation menu",
        });
      }
    },
  });
</script>
