---
import { isStaticEnvironment } from "~/lib/env";
import Chatbox from "./Chatbox.astro";

interface Props {
  children: astroHTML.JSX.Element;
}

const date = new Date();
const dateString = date.toUTCString();
const dateTimeString = date.toISOString();
const dateState = isStaticEnvironment() ? "loading" : "ready";
---

<div class="container">
  <div class="dateContainer" data-nosnippet>
    <time
      class="date"
      id="date"
      data-state={dateState}
      datetime={dateTimeString}
    >
      {dateString}
    </time>
  </div>
  <ol class="messages" role="list" aria-label="chat messages">
    <Chatbox> <span class="joinChatbox">joined the room</span> </Chatbox>
    <slot />
  </ol>
</div>

<style>
  .container {
    display: flex;
    flex-direction: column;
    row-gap: 24px;
  }

  .dateContainer {
    display: flex;
    flex-direction: row;
    width: 100%;
    place-items: center;
    justify-content: center;
    text-align: center;
  }

  .date {
    color: var(--color-muted);
  }

  .messages {
    display: flex;
    flex-direction: column;
    row-gap: 24px;
    list-style: none;
    padding: 0;
  }

  .joinChatbox {
    color: var(--color-secondary);
  }
</style>

<script>
  import { getById } from "~/lib/dom";

  const dateEle = getById<HTMLTimeElement>("date");

  if (dateEle.dataset.state === "loading") {
    const now = new Date();
    dateEle.dateTime = now.toISOString();
    dateEle.textContent = now.toUTCString();
    dateEle.dataset.state = "ready";
  }
</script>
