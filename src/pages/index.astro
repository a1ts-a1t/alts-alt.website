---
import type { WebSite, WithContext } from "schema-dts";
import VisiblyHiddenText from "~/components/core/VisiblyHiddenText";
import { getCanonicalUrl } from "~/components/layout";
import Chat from "~/components/layout/Chat.astro";
import Chatbox from "~/components/layout/Chatbox.astro";
import Layout from "~/layouts/Layout.astro";

const canonicalUrl = getCanonicalUrl(Astro);
const jsonLd: WithContext<WebSite> = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "alts_alt_",
  url: canonicalUrl.toString(),
};
---

<Layout
  title="alts_alt_"
  description="some web projects and small coding stuff from somebody too online. come say hiii!!!!!"
>
  <VisiblyHiddenText as="h1">home</VisiblyHiddenText>
  <Chat>
    <Chatbox>hi i'm alt!</Chatbox>
    <Chatbox>i'm a burnt out mess :]</Chatbox>
    <Chatbox>and sometimes i work on small coding stuff</Chatbox>
    <Chatbox>like this website!</Chatbox>
    <Chatbox>if you want, feel free to say hi!</Chatbox>
    <Chatbox>but otherwise...</Chatbox>
    <Chatbox
      ><pre aria-label="Welcome to my website" role="img">
&nbsp;----------------&nbsp;
│                │
│   WELCOME TO   │
│   MY WEBSITE   │
│       :3       │
│                │
&nbsp;----------------&nbsp;
(\__/)  ││
( •o•)  ││
/ 　 づ
</pre></Chatbox
    >
  </Chat>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
    is:inline
  />
</Layout>
