---
import type { MarkdownInstance } from "astro";
import Chat from "~/components/layout/Chat.astro";
import Chatbox from "~/components/layout/Chatbox.astro";
import Layout from "~/layouts/Layout.astro";

interface BlogPostFrontmatter {
  title: string;
  description: string;
  datePublished: string;
}

interface BlogPost {
  url: string;
  title: string;
  datePublished: Date;
  description: string;
}

const posts = Object.values(
  import.meta.glob<MarkdownInstance<BlogPostFrontmatter>>(
    "/src/pages/blog/*.md",
    { eager: true },
  ),
)
  .map(
    (post): BlogPost => ({
      url: post.url?.replace(/\.html$/, "") ?? "",
      title: post.frontmatter.title,
      description: post.frontmatter.description,
      datePublished: new Date(post.frontmatter.datePublished),
    }),
  )
  .sort((a, b) => b.datePublished.getTime() - a.datePublished.getTime());
---

<Layout title="blog | alts_alt_">
  <Chat>
    <Chatbox>here's some stuff i've written in my free time</Chatbox>
    <Chatbox>(just some stuff, not a whole lot of stuff)</Chatbox>
    <Chatbox>check it out !!</Chatbox>
  </Chat>
  <section class="blogIndex">
    <ul class="postList">
      {posts.map((post) => (
        <li>
          <a href={post.url} class="post">
            <time datetime={post.datePublished.toISOString()}>
              {post.datePublished.toUTCString().slice(0, 16)}
            </time>
            <span>{post.title}</span>
            <p class="postDescription">{post.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .blogIndex {
    display: flex;
    flex-direction: column;
    row-gap: 32px;
    margin-top: 32px;
  }

  h1 {
    color: var(--color-primary);
    font-size: var(--font-xl);
    font-weight: bold;
  }

  .postList {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    row-gap: 32px;
  }

  .post {
    border: 1px solid var(--color-text);
    display: flex;
    flex-direction: column;
    row-gap: 4px;
    padding: 16px;
  }

  .post:hover {
    text-decoration: none;
  }

  .post:hover span {
    text-decoration: underline;
  }

  time {
    color: var(--color-muted);
    font-size: var(--font-xs);
  }

  .postDescription {
    color: var(--color-muted);
  }
</style>
