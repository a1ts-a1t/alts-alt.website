---
import VisiblyHiddenText from "~/components/core/VisiblyHiddenText";
import Chat from "~/components/layout/Chat.astro";
import Chatbox from "~/components/layout/Chatbox.astro";
import { getBlogPosts } from "~/components/pages/blog";
import BlogPostEntry from "~/components/pages/blog/BlogPostEntry.astro";
import Layout from "~/layouts/Layout.astro";

const blogPosts = getBlogPosts();
---

<Layout
  title="blog | alts_alt_"
  description="some stuff i've written in my free time :]"
>
  <VisiblyHiddenText as="h1">blog posts</VisiblyHiddenText>
  <Chat>
    <Chatbox>here's some stuff i've written in my free time</Chatbox>
    <Chatbox>(just some stuff, not a whole lot of stuff)</Chatbox>
    <Chatbox>check it out !!</Chatbox>
  </Chat>
  <section class="blogIndex">
    <ul class="postList">
      {blogPosts.map((blogPost) => <BlogPostEntry post={blogPost} />)}
    </ul>
  </section>
</Layout>

<style>
  .blogIndex {
    display: flex;
    flex-direction: column;
    row-gap: 32px;
    margin-top: 32px;
  }

  h1 {
    color: var(--color-primary);
    font-size: var(--font-xl);
    font-weight: bold;
  }

  .postList {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    row-gap: 32px;
  }
</style>
