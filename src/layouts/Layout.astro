---
import Font from "astro/components/Font.astro";
import { getCanonicalUrl } from "~/components/layout";
import Footer from "~/components/layout/Footer.astro";
import Header from "~/components/layout/Header.astro";
import { isStaticEnvironment } from "~/lib/env";
import ResetStyles from "~/styles/ResetStyles.astro";
import StyleTokens from "~/styles/StyleTokens.astro";
import UtilityStyles from "~/styles/UtilityStyles.astro";

interface Props {
  title: string;
  ogType?: "website" | "article";
  description?: string;
}

const { title, description, ogType = "website" } = Astro.props;

const themeCookie = isStaticEnvironment()
  ? undefined
  : Astro.cookies.get("theme")?.value;

const htmlClasses = themeCookie === "light" ? "" : "dark";

const canonicalUrl = getCanonicalUrl(Astro);
---

<!doctype html>
<html lang="en" class={htmlClasses}>
  <head>
    <script is:inline>
      (() => {
        var read = (key) => {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        };
        var theme = read("theme");
        var dark =
          theme === "dark" ||
          ((theme === null || theme === "system") &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <link rel="icon" href="/favicon.ico">
    <link rel="canonical" href={canonicalUrl}>
    <Font cssVariable="--font-ubuntu-mono" preload />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {description && <meta property="og:description" content={description} />}
    <meta property="og:title" content={title}>
    <meta property="og:type" content={ogType}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:site_name" content="alts_alt_">
    <meta property="og:locale" content="en_US">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@alts_alt_">
    <link
      rel="alternate"
      type="application/rss+xml"
      title="alts_alt_"
      href={new URL("rss.xml", Astro.site)}
    >
    <slot name="head" />
  </head>
  <body>
    <div class="wrapper">
      <Header />
      <main><slot /></main>
      <Footer />
    </div>
  </body>
</html>

<ResetStyles />
<StyleTokens />
<UtilityStyles />

<style is:global>
  html {
    font-family: var(--font-ubuntu-mono), system-ui, sans-serif;
    font-size: var(--font-sm);
  }

  body {
    background-color: var(--color-bg);
    color: var(--color-text);
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    place-items: center;
  }

  .wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    max-width: 80%;
    width: 640px;
    min-height: 100dvh;
  }

  main {
    flex-grow: 1;
  }

  a {
    color: var(--color-enabled);
    text-decoration: none;
    text-underline-offset: 2px;
  }

  a:hover {
    text-decoration: underline;
  }
</style>

<script>
  import { initializeStores } from "~/lib/settings";

  initializeStores();
</script>
