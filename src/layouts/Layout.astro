---
import Font from "astro/components/Font.astro";
import Footer from "~/components/layout/Footer.astro";
import Header from "~/components/layout/Header.astro";
import ResetStyles from "~/styles/ResetStyles.astro";
import StyleTokens from "~/styles/StyleTokens.astro";
import UtilityStyles from "~/styles/UtilityStyles.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <link rel="icon" href="/favicon.ico">
    <Font cssVariable="--font-ubuntu-mono" preload />
    <title>{title}</title>
  </head>
  <body>
    <div class="wrapper">
      <Header />
      <main><slot /></main>
      <Footer />
    </div>
  </body>
</html>

<ResetStyles />
<StyleTokens />
<UtilityStyles />

<style is:global>
  html {
    font-family: var(--font-ubuntu-mono), system-ui, sans-serif;
    font-size: var(--font-sm);
  }

  body {
    background-color: var(--color-bg);
    color: var(--color-text);
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    place-items: center;
  }

  .wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    max-width: 80%;
    width: 640px;
    min-height: 100dvh;
  }

  main {
    flex-grow: 1;
  }

  a {
    color: var(--color-enabled);
    text-decoration: none;
    text-underline-offset: 2px;
  }

  a:hover {
    text-decoration: underline;
  }
</style>

<script>
  import { initializeStores } from "~/lib/globalStore";

  initializeStores();
</script>
