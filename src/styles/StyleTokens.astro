---
type Props = Record<string, never>;
---

<style is:global>
  html {
    --color-bg: #fff;
    --color-text: #000;
    --color-primary: #ff8db0;
    --color-secondary: #af4d07;
    --color-enabled: #50c4d9;
    --color-muted: #aaa;

    --font-xs: 12px;
    --font-sm: 18px;
    --font-md: 24px;
    --font-lg: 30px;
    --font-xl: 36px;
  }

  html.dark {
    --color-bg: #000;
    --color-text: #fff;
    --color-primary: #a40029;
    --color-secondary: #cc5500;
    --color-enabled: #0a65a8;
    --color-muted: #fff7;
  }

  html.contrast {
    --color-bg: #fff;
    --color-text: #000;
    --color-primary: #e02076;
    --color-secondary: #7f1d07;
    --color-enabled: #007acb;
    --color-muted: #767676;
  }

  html.dark.contrast {
    --color-bg: #000;
    --color-text: #fff;
    --color-primary: #df3568;
    --color-secondary: #f8954f;
    --color-enabled: #279bb0;
    --color-muted: #fffa;
  }
</style>
